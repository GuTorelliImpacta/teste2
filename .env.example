VITE_SITE_URL=https://marcenariadamadi.com.br
# Domínio do analytics sem cookie (Plausible/Umami). Vazio = analytics desligado.
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SRC=
